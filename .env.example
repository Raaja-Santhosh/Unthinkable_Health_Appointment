# Auth
AUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Gemini AI (Free tier - https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Cron Security
CRON_SECRET=your_cron_secret_here

# Email (Ethereal - free test SMTP, get creds at https://ethereal.email)
EMAIL_USER=your_ethereal_user
EMAIL_PASS=your_ethereal_pass

# Optional: Google Calendar (mock by default, no cost)
USE_GOOGLE_CALENDAR=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
